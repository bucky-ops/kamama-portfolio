# Server-side secrets - copy to .env.local and fill in (never committed)
# SQLite database (required)
DATABASE_URL=file:./db/custom.db

# GitHub PAT for live repo stats + releases feed (optional, server-side only)
GITHUB_TOKEN=

# Admin inbox key (optional - enables /api/admin/leads; keep server-side only)
ADMIN_KEY=

# ---------------------------------------------------------------------------
# Email sending (contact form leads)
# Pick ONE transport by setting its credentials. Nothing set = emails are
# skipped gracefully and leads are still stored in the database.
#
# Option 1 - Resend (recommended on Vercel, zero dependencies)
RESEND_API_KEY=
MAIL_FROM=Kamama Portfolio <onboarding@resend.dev>
# Option 2 - SMTP (Gmail app password, Zoho, Mailgun, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Local QA only - renders the full email into the server log instead of sending
# MAIL_TRANSPORT=log
#
# Where lead notifications go (defaults to the founder inbox)
MAIL_TO=muchiri.collin@aol.com
